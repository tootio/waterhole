# Waterhole deployment configuration.
#
# Every Waterhole runs the same code; everything that makes this one yours is
# set here. Copy this file to .env.production (never commit it), or pass the
# same variables to the container (docker --env-file, Kamal env). Variables
# already present in the environment win over this file.

# ---------------------------------------------------------------------------
# Identity -- required
# ---------------------------------------------------------------------------

# The public host of this deployment, without scheme. Instance admins put it in
# their DNS TXT record, and it forms the OAuth redirect URI, so it must stay
# stable: changing it invalidates every instance's published record at once.
WATERHOLE_HOST=waterhole.example.org

# ---------------------------------------------------------------------------
# Secrets -- required. Generate with: bin/rails waterhole:secrets
# ---------------------------------------------------------------------------

# Signs cookies. Rotating it signs everyone out.
SECRET_KEY_BASE=

# Encrypt stored access tokens, OAuth client secrets and applicant emails.
# Losing them makes that data unrecoverable; back them up with the database.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Keys everything compared across instances without being shared in the clear:
# the hashed email and the join-reason fingerprint. Changing it stops existing
# requests from matching until bin/rails waterhole:rehash_match_keys is run.
WATERHOLE_SHARING_HMAC_KEY=

# ---------------------------------------------------------------------------
# Database -- PostgreSQL. Same variable names as Mastodon.
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=waterhole_production
DB_USER=waterhole
DB_PASS=

# Solid Cache, Solid Queue and Solid Cable each use their own database. By
# default they sit on the primary's server with the primary's credentials,
# named <DB_NAME>_cache, <DB_NAME>_queue and <DB_NAME>_cable. To move one
# elsewhere, set any of its variables; whatever is left unset (or blank) falls
# back to the primary's value.
# CACHE_DB_HOST=
# CACHE_DB_PORT=
# CACHE_DB_NAME=
# CACHE_DB_USER=
# CACHE_DB_PASS=
# QUEUE_DB_HOST=
# QUEUE_DB_PORT=
# QUEUE_DB_NAME=
# QUEUE_DB_USER=
# QUEUE_DB_PASS=
# CABLE_DB_HOST=
# CABLE_DB_PORT=
# CABLE_DB_NAME=
# CABLE_DB_USER=
# CABLE_DB_PASS=

# ---------------------------------------------------------------------------
# Admission policy -- optional
# ---------------------------------------------------------------------------

# allow_all (default): any instance publishing the DNS record may connect,
# except domains blocked with bin/rails "waterhole:block[domain,reason]".
# allowlist_only: only domains added with bin/rails "waterhole:allow[domain]".
# WATERHOLE_POLICY_MODE=allow_all

# Days an instance keeps working after this deployment's legal documents change,
# before its admin must republish the DNS record. 0 cuts access immediately.
# WATERHOLE_TERMS_GRACE_DAYS=14

# Days after the decision until a request is deleted with all its data, notes
# included. The privacy policy states this period: keep the two in step.
# WATERHOLE_RETENTION_DAYS=90

# Link to this deployment's source code, shown in the footer. Defaults to the
# upstream repository, which is correct as long as you run it unmodified.
# Waterhole is AGPL-3.0: if you run a modified version, you must offer its
# source to your users (section 13) -- point this at your fork.
# WATERHOLE_SOURCE_URL=https://github.com/tootio/waterhole

# ---------------------------------------------------------------------------
# Files -- optional
# ---------------------------------------------------------------------------

# Your terms_of_service.md, privacy_policy.md and imprint.md. Until they exist,
# the templates from config/legal are shown behind a warning banner. Start from
# those templates with: bin/rails waterhole:legal:install
# Default: storage/legal (on the storage volume in a container).
# WATERHOLE_LEGAL_DIR=

# Downloaded IP data: the geolocation databases and the iCloud Private Relay
# address list (refreshed daily) and the Tor relay list (hourly).
# Default: storage/ipdata
# WATERHOLE_IPDATA_DIR=

# ---------------------------------------------------------------------------
# Email -- optional
# ---------------------------------------------------------------------------

# Who runs this Waterhole: notified when an instance's DNS record asks to join
# cross-instance signals and is waiting for approval. Comma-separated for
# several people. Nothing is sent unless SMTP_SERVER is set too.
# WATERHOLE_OPERATOR_EMAIL=

# The outgoing mail server. Same variable names as Mastodon's, so your
# instance's settings can be copied across.
# SMTP_SERVER=smtp.example.org
# Defaults to 587, or 465 with SMTP_TLS=true.
# SMTP_PORT=587
# SMTP_LOGIN=
# SMTP_PASSWORD=
# plain (default when SMTP_LOGIN is set), login, cram_md5 or none.
# SMTP_AUTH_METHOD=plain
# STARTTLS on port 587: auto (use it if offered, the default), always (refuse
# to send without it) or never.
# SMTP_ENABLE_STARTTLS=auto
# Implicit TLS from the first byte, usually port 465. Replaces STARTTLS.
# SMTP_TLS=false
# Certificate check: peer (default) or none. Keep peer outside a lab.
# SMTP_OPENSSL_VERIFY_MODE=peer
# A CA bundle for a server with a private certificate authority.
# SMTP_CA_FILE=
# HELO name. Defaults to WATERHOLE_HOST.
# SMTP_DOMAIN=
# Defaults to "Waterhole <notifications@WATERHOLE_HOST>".
# SMTP_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Error reporting -- optional
# ---------------------------------------------------------------------------

# Report crashes and bugs to Sentry or GlitchTip: paste the project's DSN.
# Unset means no reporting at all. Expected failures (an instance offline or
# rate limiting, a revoked token, a lost role) are never reported, and events
# carry no cookies, request bodies, search terms, SQL values or user details.
# SENTRY_DSN=
# Defaults to the Rails environment (production).
# SENTRY_ENVIRONMENT=
# Defaults to the image's release tag; set it for builds of your own.
# SENTRY_RELEASE=

# ---------------------------------------------------------------------------
# Runtime -- optional, standard Rails/Puma settings
# ---------------------------------------------------------------------------

# RAILS_LOG_LEVEL=info
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=1
# JOB_CONCURRENCY=1
# Run background jobs inside the web process (single-server setups):
# SOLID_QUEUE_IN_PUMA=true
