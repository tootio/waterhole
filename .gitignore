# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files: a deployment's .env.production holds its secrets.
# The development and test files only carry throwaway keys, and the sample
# documents every setting.
/.env*
!/.env.development
!/.env.test
!/.env.production.sample

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/public/assets

# Each deployment's own Kamal config, copied from config/deploy.yml.example
# (including per-destination files such as deploy.staging.yml).
/config/deploy.yml
/config/deploy.*.yml

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

# Runtime data: downloaded IP databases and the operator's legal documents
# (storage/legal; config/legal only holds the committed templates). The directory itself is kept so the image owns it as the app user.
/storage/*
!/storage/.keep

# JetBrains IDE settings (machine-specific)
/.idea/

# The operator's legal documents when running docker compose (see docker-compose.yml).
/legal/
