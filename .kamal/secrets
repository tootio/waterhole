# Secrets for config/deploy.yml (env/secret, accessories/*/env/secret,
# registry/password). This file is committed, so it holds no values: they are
# read from the deployment's .env.production, which is never committed, and
# from your shell.

SECRET_KEY_BASE=$(grep ^SECRET_KEY_BASE= .env.production | cut -d= -f2-)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(grep ^ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY= .env.production | cut -d= -f2-)
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(grep ^ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY= .env.production | cut -d= -f2-)
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(grep ^ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT= .env.production | cut -d= -f2-)
WATERHOLE_SHARING_HMAC_KEY=$(grep ^WATERHOLE_SHARING_HMAC_KEY= .env.production | cut -d= -f2-)
DB_PASS=$(grep ^DB_PASS= .env.production | cut -d= -f2-)

# The db accessory is created with the password the app connects with.
POSTGRES_PASSWORD=$DB_PASS

# Registry token from your shell, or from a password manager, e.g.:
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item KAMAL_REGISTRY_PASSWORD)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
