<% content_for :page_title, @instance.domain %>

<% if @instance == current_instance %>
  <%= render "shared/my_herd_tabs" %>
<% end %>

<div class="mb-4">
  <% unless @instance == current_instance %>
    <p class="text-sm"><%= link_to "← Herds", herds_path, class: button_classes(:ghost, "rounded underline hover:text-stone-900 dark:hover:text-stone-100") %></p>
  <% end %>
  <h1 class="mt-1 text-2xl font-semibold tracking-tight"><%= @instance.domain %></h1>
  <p class="mt-1 text-sm">
    <%= link_to @instance.base_url, @instance.base_url, rel: "noopener",
          class: "rounded text-indigo-700 dark:text-indigo-400 underline hover:text-indigo-900 dark:hover:text-indigo-300 #{focus_ring_classes}" %>
  </p>
</div>

<%# Your own herd is the only one whose sync, tokens and failed checks are any
    of your business; every other page is the two facts that concern you. %>
<%= render(@instance == current_instance ? "instance" : "herd", instance: @instance) %>
