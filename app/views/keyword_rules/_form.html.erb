<%= form_with model: keyword_rule, class: "space-y-4 rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5" do |f| %>
  <% if keyword_rule.errors.any? %>
    <div class="rounded bg-red-50 dark:bg-red-950 px-3 py-2 text-sm text-red-900 dark:text-red-200">
      <%= keyword_rule.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <div class="flex items-center justify-between gap-3">
      <%= f.label :pattern, class: "block text-sm font-medium" %>
      <%= link_to regexp_help_path, data: { action: "modal#open" }, aria: { label: "Regexp help" },
            class: button_classes(:ghost, "rounded text-sm hover:text-stone-900 dark:hover:text-stone-100") do %>
        <span aria-hidden="true">ⓘ</span> Regexp help
      <% end %>
    </div>
    <%= f.text_field :pattern, required: true, class: "mt-1 w-full rounded border border-stone-300 dark:border-stone-700 px-3 py-2" %>
  </div>

  <div class="flex flex-wrap gap-4">
    <div>
      <%= f.label :match_type, "Match", class: "block text-sm font-medium" %>
      <%= f.select :match_type, KeywordRule::MATCH_TYPES.map { [ it.humanize, it ] }, {},
            class: "mt-1 rounded border border-stone-300 dark:border-stone-700 px-3 py-2" %>
    </div>

    <div>
      <%= f.label :severity, class: "block text-sm font-medium" %>
      <%= f.select :severity, Flag::SEVERITIES.keys.map { [ it.to_s.humanize, it ] }, {},
            class: "mt-1 rounded border border-stone-300 dark:border-stone-700 px-3 py-2" %>
    </div>
  </div>

  <div>
    <%= f.label :description, "Note (optional)", class: "block text-sm font-medium" %>
    <%= f.text_field :description, class: "mt-1 w-full rounded border border-stone-300 dark:border-stone-700 px-3 py-2" %>
  </div>

  <label class="flex items-center gap-2 text-sm">
    <%= f.check_box :enabled, class: "rounded border-stone-300 dark:border-stone-700" %> Enabled
  </label>

  <div class="flex gap-3">
    <%= f.submit class: button_classes(:solid, "px-4 py-2 text-sm") %>
    <%= link_to "Cancel", keyword_rules_path, class: button_classes(:outline, "px-4 py-2 text-sm") %>
  </div>
<% end %>
