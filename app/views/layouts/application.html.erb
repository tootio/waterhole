<!DOCTYPE html>
<html class="h-full" lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)">
    <%= render "shared/meta" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-dvh flex-col overflow-x-hidden bg-stone-50 dark:bg-stone-950 text-stone-900 dark:text-stone-100 antialiased"
        data-controller="modal">
    <%= render "shared/skip_links" %>

    <%# Only the navigation badge, and only ever the badge: a queue change
        replaces that one element, so a moderator halfway through a watchword on
        another page never has the page refreshed under them. The queue's own
        live updates ride the separate stream it subscribes to itself. %>
    <% if signed_in? && current_instance %>
      <%= turbo_stream_from current_instance, :queue_badge %>
    <% end %>

    <header class="border-b border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:gap-6">
        <%= link_to (signed_in? ? root_path : new_session_path),
              class: "flex shrink-0 items-center gap-2 rounded font-semibold tracking-tight #{focus_ring_classes}" do %>
          <%= image_tag "/icon.svg", alt: "", class: "size-6" %>
          <span class="sr-only sm:not-sr-only">Waterhole</span>
        <% end %>

        <nav id="main-navigation" tabindex="-1" aria-label="Main"
             class="flex min-w-0 flex-1 items-center gap-3 text-sm outline-none">
          <% if !signed_in? || current_moderator.consent_current? %>
            <ul class="-m-1 flex min-w-0 items-center gap-1 overflow-x-auto p-1 sm:gap-4">
              <% if signed_in? %>
                <li>
                  <%= link_to root_path, class: "#{nav_class(controller_name == "registration_requests")} inline-flex items-center gap-1.5 whitespace-nowrap" do %>
                    Queue <%= render "shared/queue_badge", instance: current_instance %>
                  <% end %>
                </li>
                <li><%= link_to "My herd", herd_path(current_instance), class: "#{nav_class(my_herd_page?)} block whitespace-nowrap" %></li>
                <li><%= link_to "Herds", herds_path, class: "#{nav_class(controller_name == "instances" && !my_herd_page?)} block whitespace-nowrap" %></li>
              <% else %>
                <li><%= link_to "About", verification_path, class: "#{nav_class(controller_name == "verifications")} block whitespace-nowrap" %></li>
              <% end %>
            </ul>
          <% end %>

          <div class="ml-auto flex shrink-0">
            <% if signed_in? %>
              <details data-controller="dropdown" class="relative">
                <summary aria-controls="account-menu" aria-expanded="false"
                         class="flex cursor-pointer list-none rounded-full [&::-webkit-details-marker]:hidden <%= focus_ring_classes %>">
                  <%= moderator_avatar(current_moderator) %>
                  <span class="sr-only">Account: <%= current_moderator.handle %></span>
                </summary>
                <div id="account-menu"
                     class="absolute right-0 z-20 mt-2 w-64 max-w-[calc(100vw-2rem)] overflow-hidden rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 py-1 shadow-lg">
                  <p class="px-3 py-2 text-xs text-stone-500 dark:text-stone-400">
                    Signed in as
                    <span class="block break-all text-sm font-medium text-stone-900 dark:text-stone-100"><%= current_moderator.handle %></span>
                  </p>
                  <div class="border-t border-stone-200 dark:border-stone-800 pt-1">
                    <%= button_to "Sign out", session_path, method: :delete,
                          class: "block w-full px-3 py-1.5 text-left text-sm hover:bg-stone-100 dark:hover:bg-stone-800 #{focus_ring_classes}" %>
                  </div>
                </div>
              </details>
            <% elsif !(controller_name == "sessions" && action_name == "new") %>
              <%= link_to new_session_path, title: "Sign in",
                    class: "flex size-8 items-center justify-center rounded-full bg-stone-200 dark:bg-stone-700 text-stone-600 dark:text-stone-300 hover:bg-stone-300 dark:hover:bg-stone-600 #{focus_ring_classes}" do %>
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                  <path d="M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8a7 7 0 1 1 14 0H3Z"/>
                </svg>
                <span class="sr-only">Sign in</span>
              <% end %>
            <% end %>
          </div>
        </nav>
      </div>
    </header>

    <% if signed_in? && current_instance&.terms_outdated? %>
      <%= render "shared/terms_banner" %>
    <% end %>
    <% if signed_in? && current_moderator.reauthorization_pending? %>
      <%= render "shared/reauthorize_banner" %>
    <% end %>

    <%= render "shared/flash" %>

    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 outline-none">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <% if signed_in? %>
      <%= render "shared/help_dialog" %>
      <%= render "shared/confirm_dialog" %>
    <% end %>
  </body>
</html>
