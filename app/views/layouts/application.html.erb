<!DOCTYPE html>
<html class="h-full" lang="<%= I18n.locale %>">
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)">
    <%= render "shared/meta" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-dvh flex-col overflow-x-hidden bg-stone-50 dark:bg-stone-950 text-stone-900 dark:text-stone-100 antialiased"
        data-controller="modal">
    <%= render "shared/skip_links" %>

    <%# Only the navigation badge, and only ever the badge: a queue change
        replaces that one element, so a moderator halfway through a watchword on
        another page never has the page refreshed under them. The queue's own
        live updates ride the separate stream it subscribes to itself. %>
    <% if signed_in? && current_instance %>
      <%= turbo_stream_from current_instance, :queue_badge %>
    <% end %>

    <header class="border-b border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <%= link_to (signed_in? ? root_path : new_session_path),
              class: "order-1 flex shrink-0 items-center gap-2 font-semibold tracking-tight" do %>
          <%= image_tag "/icon.svg", alt: "", class: "size-6" %>
          <span>Waterhole</span>
        <% end %>

        <% if signed_in? %>
          <div class="order-2 ml-auto flex items-center gap-3 text-sm sm:order-3">
            <% if current_moderator.consent_current? %>
              <%= button_to "Sync now", sync_path, class: button_classes(:outline, "px-2 py-1 whitespace-nowrap text-stone-700 dark:text-stone-300") %>
            <% end %>
            <span class="hidden text-stone-500 dark:text-stone-400 sm:inline"><%= current_moderator.handle %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: button_classes(:ghost, "rounded whitespace-nowrap underline hover:text-stone-900 dark:hover:text-stone-100") %>
          </div>

          <% if current_moderator.consent_current? %>
          <nav id="main-navigation" tabindex="-1"
               class="order-3 -mx-4 flex w-full items-center gap-1 overflow-x-auto px-4 text-sm outline-none sm:order-2 sm:mx-0 sm:w-auto sm:gap-4 sm:overflow-visible sm:px-0">
            <%= link_to root_path, class: "#{nav_class(controller_name == "registration_requests")} inline-flex items-center gap-1.5 whitespace-nowrap" do %>
              Queue <%= render "shared/queue_badge", instance: current_instance %>
            <% end %>
            <%= link_to "My herd", herd_path(current_instance), class: "#{nav_class(my_herd_page?)} whitespace-nowrap" %>
            <%= link_to "Herds", herds_path, class: "#{nav_class(controller_name == "instances" && !my_herd_page?)} whitespace-nowrap" %>
          </nav>
          <% end %>
        <% else %>
          <div class="order-2 ml-auto flex items-center gap-3 text-sm sm:gap-4">
            <%= link_to "About", verification_path,
                  class: "#{nav_class(controller_name == "verifications")} whitespace-nowrap" %>
            <% unless controller_name == "sessions" && action_name == "new" %>
              <%= link_to "Sign in", new_session_path,
                    class: button_classes(:outline, "bg-white dark:bg-stone-800 px-3 py-1 whitespace-nowrap text-stone-900 dark:text-stone-100") %>
            <% end %>
          </div>
        <% end %>
      </div>
    </header>

    <% if signed_in? && current_instance&.terms_outdated? %>
      <%= render "shared/terms_banner" %>
    <% end %>

    <%= render "shared/flash" %>

    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 outline-none">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <% if signed_in? %>
      <%= render "shared/help_dialog" %>
      <%= render "shared/confirm_dialog" %>
    <% end %>
  </body>
</html>
