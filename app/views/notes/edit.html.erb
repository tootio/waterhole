<% content_for :title, "Edit note — Waterhole" %>

<div class="mx-auto max-w-2xl">
  <h1 class="mb-4 text-xl font-semibold">Edit note</h1>

  <%= form_with model: @note, class: "rounded-lg border border-stone-200 bg-white p-5" do |f| %>
    <%= f.text_area :body, rows: 5, class: "w-full rounded border border-stone-300 px-3 py-2 text-sm" %>
    <div class="mt-3 flex gap-3">
      <%= f.submit "Save", class: "rounded bg-stone-900 px-4 py-2 text-sm text-white" %>
      <%= link_to "Cancel", registration_request_path(@note.registration_request),
            class: "rounded border border-stone-300 px-4 py-2 text-sm" %>
    </div>
  <% end %>
</div>
