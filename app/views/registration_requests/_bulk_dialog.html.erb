<%# data-turbo-permanent: every decision broadcasts a refresh, and a morph must
    not reset this dialog halfway through a run. Its content is built by
    bulk_select_controller.js with textContent only (Trusted Types). %>
<dialog id="bulk-dialog"
        data-turbo-permanent
        data-bulk-select-target="dialog"
        data-action="cancel->bulk-select#cancel click->bulk-select#closeOnBackdrop"
        aria-labelledby="bulk-dialog-title"
        class="fixed inset-0 m-auto hidden max-h-[85dvh] w-full max-w-lg flex-col rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-0 text-stone-900 dark:text-stone-100 shadow-xl [&[open]]:flex backdrop:bg-stone-950/60">
  <div class="border-b border-stone-200 dark:border-stone-800 px-5 py-4">
    <h2 id="bulk-dialog-title" data-bulk-select-target="title" class="font-semibold"></h2>
    <p data-bulk-select-target="progress" aria-live="polite" class="mt-1 text-sm text-stone-600 dark:text-stone-300"></p>
  </div>
  <ol data-bulk-select-target="results"
      class="min-h-0 flex-1 divide-y divide-stone-100 dark:divide-stone-800 overflow-y-auto px-5 text-sm"></ol>
  <form method="dialog" class="flex justify-end gap-2 border-t border-stone-200 dark:border-stone-800 px-4 py-3">
    <button type="button" data-bulk-select-target="stop" data-action="bulk-select#stop"
            class="<%= button_classes(:outline_danger, "px-3 py-1.5 text-sm") %>">
      Stop
    </button>
    <button type="submit" value="close" data-bulk-select-target="close"
            class="<%= button_classes(:solid, "px-3 py-1.5 text-sm") %>">
      Close
    </button>
  </form>
</dialog>
