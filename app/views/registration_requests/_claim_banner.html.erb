<%# Claiming is what stops two people working the same request, so this has to be
    unmissable and has to update for other viewers without a refresh. %>
<div id="<%= dom_id(registration_request, :claim_banner) %>" class="mb-6">
  <% if registration_request.resolved? %>
    <div class="rounded-lg border border-stone-200 dark:border-stone-800 bg-stone-100 dark:bg-stone-800 px-4 py-3 text-sm text-stone-600 dark:text-stone-300">
      Resolved <%= local_time(registration_request.resolved_at) %>.
    </div>
  <% elsif registration_request.claimed_by == current_moderator %>
    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-indigo-200 dark:border-indigo-900 bg-indigo-50 dark:bg-indigo-950 px-4 py-3">
      <span class="text-sm text-indigo-900 dark:text-indigo-200"><strong>You claimed this</strong> <%= relative_time(registration_request.claimed_at) %>.</span>
      <%= button_to "Release", registration_request_claim_path(registration_request), method: :delete,
            class: "ml-auto rounded border border-indigo-300 dark:border-indigo-700 bg-white dark:bg-indigo-900 px-3 py-1 text-sm text-indigo-900 dark:text-indigo-200 hover:bg-indigo-100 dark:hover:bg-indigo-800 #{focus_ring_classes}" %>
    </div>
  <% elsif registration_request.claimed? %>
    <div class="flex flex-wrap items-center gap-3 rounded-lg border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950 px-4 py-3">
      <span class="text-sm text-amber-900 dark:text-amber-200">
        <strong><%= registration_request.claimed_by.name %></strong> is reviewing this
        (claimed <%= relative_time(registration_request.claimed_at) %>).
      </span>
      <% if registration_request.claim_stale? %>
        <%= button_to "Take over", registration_request_claim_path(registration_request, force: 1),
              form: { data: { turbo_confirm: "#{registration_request.claimed_by.name} claimed this #{time_ago_in_words(registration_request.claimed_at)} ago. Take it over?" } },
              class: "ml-auto rounded border border-amber-300 dark:border-amber-700 bg-white dark:bg-amber-900 px-3 py-1 text-sm text-amber-900 dark:text-amber-200 hover:bg-amber-100 dark:hover:bg-amber-800 #{focus_ring_classes}" %>
      <% end %>
    </div>
  <% else %>
    <%= button_to "Claim this request", registration_request_claim_path(registration_request),
          class: "w-full rounded-lg bg-stone-900 dark:bg-stone-100 px-4 py-2.5 text-sm font-medium text-white dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-white #{focus_ring_classes}" %>
  <% end %>
</div>
