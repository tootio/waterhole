<%- d = flag.details -%>
<%- case flag.rule -%>
<%- when "disposable_email" -%>
  <%= d["domain"] %> is a throwaway provider
<%- when "short_invite_request" -%>
  only <%= pluralize(d["word_count"].to_i, "word") %>
<%- when "shared_ip" -%>
  same IP as <%= d["usernames"].to_a.map { "@#{it}" }.to_sentence %>
<%- when "reapplication" -%>
  matches <%= pluralize(d["count"].to_i, "earlier rejected request") %> by <%= d["matched_on"] %>
<%- when "keyword_hit" -%>
  matched <%= d["patterns"].to_a.map { "“#{it}”" }.to_sentence %>
<%- when "datacenter_asn" -%>
  <%= d["org"].presence || "AS#{d["asn"]}" %><%= " (AS#{d["asn"]})" if d["org"].present? %>
  <%= "— matched on the organisation name" if d["matched"] == "keyword" %>
  <%= "· data #{d["data_age_days"]} days old" if d["data_age_days"].to_i > 30 %>
<%- when "tor_relay" -%>
  signed up from the address of a running Tor relay (list: <%= d["source"] %>)
<%- when "ip_active_elsewhere" -%>
  same <%= d["scope"] == "/64" ? "IPv6 /64" : "address" %> as
  <%= d["capped"] ? "#{d["count"]}+ requests" : pluralize(d["count"].to_i, "request") %>
  on <%= d["instances"].to_a.to_sentence %>
<%- when "email_active_elsewhere" -%>
  also active on <%= d["instances"].to_a.to_sentence.presence || pluralize(d["count"].to_i, "other instance") %>
<%- when "similar_reason" -%>
  <%# Usernames from this instance only; elsewhere, just the domain. %>
  <%- where = [ d["usernames"].to_a.map { "@#{it}" }.to_sentence.presence, d["instances"].to_a.presence && "on #{d["instances"].to_a.to_sentence}" ].compact -%>
  join reason nearly identical to <%= d["capped"] ? "#{d["count"]}+ requests" : pluralize(d["count"].to_i, "other request") %><%= " (#{where.join("; ")})" if where.any? %>
<%- when "signup_burst" -%>
  <%- domain, pattern, locale = d["shape"].to_s.split(" ", 3) -%>
  <%= d["count"] %> signups within <%= d["window_minutes"] %> minutes of each other from <%= d["networks"] %> different networks, all <%= domain %> addresses with usernames shaped like <%= pattern %><%= " and locale #{locale}" unless locale == "-" %><%= " (also on #{d["instances"].to_a.to_sentence})" if d["instances"].to_a.any? %>
<%- when "app_signup" -%>
  created through an OAuth app (#<%= d["application_id"] %>), not the website's sign-up form
<%- else -%>
  <%= d.to_json %>
<%- end -%>
