<section class="rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5">
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">Automated flags</h2>

  <% if registration_request.flags.any? %>
    <ul class="space-y-2">
      <% registration_request.flags.sort_by { -it.severity_before_type_cast }.each do |flag| %>
        <li class="rounded px-3 py-2 <%= severity_style(flag.severity) %>">
          <p class="text-sm font-medium">
            <%= flag.label %>
            <%= link_to "ⓘ", flag_help_path(flag),
                  class: "ml-1 rounded text-stone-400 dark:text-stone-500 hover:text-stone-700 dark:hover:text-stone-200 #{focus_ring_classes}",
                  title: "About this flag", "aria-label": "About #{flag.label}",
                  data: { action: "modal#open" } %>
          </p>
          <% if flag.details.present? %>
            <p class="mt-0.5 text-xs opacity-80"><%= render "flag_detail", flag: flag %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="mt-3 text-xs text-stone-500 dark:text-stone-400">Flags are hints for triage. They never decide anything.</p>
  <% else %>
    <p class="text-sm text-stone-500 dark:text-stone-400">Nothing flagged.</p>
  <% end %>
</section>
