<section class="rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5" data-controller="clipboard">
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">Applicant</h2>

  <dl class="space-y-3 text-sm">
    <div>
      <dt class="text-xs text-stone-500 dark:text-stone-400">Signed up</dt>
      <dd><%= local_time(registration_request.signed_up_at) %></dd>
    </div>

    <div>
      <dt class="text-xs text-stone-500 dark:text-stone-400">Email</dt>
      <dd class="flex items-center gap-2">
        <span class="break-all font-mono text-xs"><%= registration_request.email.presence || "—" %></span>
        <% if registration_request.email.present? %>
          <button type="button" class="<%= button_classes(:ghost, "rounded text-xs hover:text-stone-700 dark:hover:text-stone-300") %>"
                  data-action="clipboard#copy" data-clipboard-value="<%= registration_request.email %>">copy</button>
          <% if email_templates.any? %>
            <div data-controller="dropdown" class="dropdown">
              <button type="button" popovertarget="email-template-menu" aria-expanded="false" data-dropdown-target="toggle"
                      class="dropdown-toggle <%= button_classes(:ghost, "rounded text-xs whitespace-nowrap hover:text-stone-700 dark:hover:text-stone-300") %>">email ▾</button>
              <ul id="email-template-menu" popover data-dropdown-target="panel" class="dropdown-panel sm:w-56">
                <% email_templates.each do |template| %>
                  <li>
                    <%= link_to template.name, template_mailto(template, registration_request),
                          class: "block px-3 py-1.5 text-sm hover:bg-stone-100 dark:hover:bg-stone-800 #{focus_ring_classes}" %>
                  </li>
                <% end %>
                <li class="border-t border-stone-200 dark:border-stone-800">
                  <%= link_to "Manage templates", email_templates_path,
                        class: "block px-3 py-1.5 text-xs text-stone-500 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-800 #{focus_ring_classes}" %>
                </li>
              </ul>
            </div>
          <% else %>
            <%= link_to "templates", email_templates_path, title: "Set up email templates to write to applicants in one click",
                  class: button_classes(:ghost, "rounded text-xs hover:text-stone-700 dark:hover:text-stone-300") %>
          <% end %>
        <% end %>
      </dd>
      <% if registration_request.confirmed? %>
        <dd class="mt-1 text-xs text-stone-500 dark:text-stone-400">confirmed</dd>
      <% else %>
        <dd class="mt-1 text-xs text-amber-800 dark:text-amber-200">
          not confirmed yet — Mastodon deletes the account if it stays unconfirmed
          for <%= RegistrationRequest::UNCONFIRMED_ACCOUNT_LIFETIME.inspect %> after signup
        </dd>
      <% end %>
    </div>

    <div>
      <dt class="text-xs text-stone-500 dark:text-stone-400">Signup IP</dt>
      <dd class="flex items-center gap-2">
        <span class="font-mono text-xs"><%= registration_request.ip.presence || "—" %></span>
        <% if registration_request.ip.present? %>
          <button type="button" class="<%= button_classes(:ghost, "rounded text-xs hover:text-stone-700 dark:hover:text-stone-300") %>"
                  data-action="clipboard#copy" data-clipboard-value="<%= registration_request.ip %>">copy</button>
        <% end %>
      </dd>
    </div>

    <% if registration_request.ip_enriched_at.present? %>
      <div>
        <dt class="text-xs text-stone-500 dark:text-stone-400">Network</dt>
        <dd>
          <% if registration_request.ip_country.present? %>
            <% country_name = Ip::Countries.name_for(registration_request.ip_country) %>
            <% if country_name %>
              <abbr title="<%= country_name %>" class="font-medium no-underline cursor-help"><%= registration_request.ip_country %></abbr>
            <% else %>
              <span class="font-medium"><%= registration_request.ip_country %></span>
            <% end %>
          <% end %>
          <% if registration_request.ip_asn.present? %>
            <span class="text-stone-600 dark:text-stone-300">
              AS<%= registration_request.ip_asn %> <%= registration_request.ip_asn_org %>
            </span>
          <% elsif registration_request.ip_country.blank? %>
            <span class="text-stone-500 dark:text-stone-400">no data for this address</span>
          <% end %>
          <% if (research = network_research_links(registration_request)).any? %>
            <div data-controller="dropdown" class="dropdown inline-block">
              <button type="button" popovertarget="network-research-menu" aria-expanded="false" data-dropdown-target="toggle"
                      class="dropdown-toggle <%= button_classes(:ghost, "rounded text-xs whitespace-nowrap hover:text-stone-700 dark:hover:text-stone-300") %>">look up ▾</button>
              <div id="network-research-menu" popover data-dropdown-target="panel" class="dropdown-panel sm:w-64">
                <% research.each_with_index do |(subject, links), index| %>
                  <p class="<%= "border-t border-stone-200 dark:border-stone-800 mt-1 pt-1 " if index > 0 %>px-3 py-1 font-mono text-xs text-stone-500 dark:text-stone-400 truncate"><%= subject %></p>
                  <ul>
                    <% links.each do |label, url| %>
                      <li>
                        <%= link_to label, url, target: "_blank", rel: "noopener noreferrer",
                              class: "block px-3 py-1.5 text-sm hover:bg-stone-100 dark:hover:bg-stone-800 #{focus_ring_classes}" %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            </div>
          <% end %>
          <% case registration_request.ip_relay %>
          <% when "private_relay" %>
            <span class="block text-xs text-stone-500 dark:text-stone-400">iCloud Private Relay — an address shared by many Apple users</span>
          <% when "tor" %>
            <span class="block text-xs text-stone-500 dark:text-stone-400">Tor relay — this address was running a Tor relay when the signup was seen</span>
          <% end %>
        </dd>
      </div>
    <% end %>

    <% if registration_request.locale.present? %>
      <div>
        <dt class="text-xs text-stone-500 dark:text-stone-400">Locale</dt>
        <dd><%= registration_request.locale %></dd>
      </div>
    <% end %>

    <% if registration_request.bio.present? %>
      <div>
        <dt class="text-xs text-stone-500 dark:text-stone-400">Profile note</dt>
        <dd class="whitespace-pre-wrap text-stone-700 dark:text-stone-300"><%= highlight_keywords(registration_request.bio, field: :bio) %></dd>
      </div>
    <% end %>

    <% if registration_request.account_url.present? %>
      <div>
        <dt class="text-xs text-stone-500 dark:text-stone-400">In Mastodon</dt>
        <dd><%= link_to "Open admin view", "#{registration_request.instance.base_url}/admin/accounts/#{registration_request.mastodon_account_id}",
              target: "_blank", rel: "noopener", class: "text-indigo-700 dark:text-indigo-400 underline" %></dd>
      </div>
    <% end %>
  </dl>
</section>
