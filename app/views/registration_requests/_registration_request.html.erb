<li id="<%= dom_id(registration_request) %>"
    class="flex hover:bg-stone-50 dark:hover:bg-stone-800 has-[a:focus-visible]:bg-stone-50 dark:has-[a:focus-visible]:bg-stone-800">
  <%# Beside the link, not inside it: a checkbox within an <a> would open the
      detail page on every tick. Only pending requests can be acted on in bulk,
      but the others keep the gutter so the list stays aligned. %>
  <% if registration_request.pending? %>
    <label class="flex shrink-0 cursor-pointer items-start py-3.5 pl-4 pr-1" title="Select @<%= registration_request.username %>">
      <input type="checkbox"
             value="<%= registration_request.id %>"
             aria-label="Select @<%= registration_request.username %>"
             class="size-4 rounded border-stone-300 dark:border-stone-600 accent-stone-900 dark:accent-stone-100 <%= focus_ring_classes %>"
             data-bulk-select-target="checkbox"
             data-action="bulk-select#toggle"
             data-username="<%= registration_request.username %>"
             data-decision-url="<%= registration_request_decision_path(registration_request) %>"
             data-claim-url="<%= registration_request_claim_path(registration_request) %>"
             data-claimed-by="<%= !registration_request.claimed? ? "none" : registration_request.claimed_by == current_moderator ? "me" : "other" %>"
             data-claimer-name="<%= registration_request.claimed_by&.name %>">
    </label>
  <% else %>
    <span class="w-9 shrink-0" aria-hidden="true"></span>
  <% end %>
  <%# turbo_frame "_top" because this row sits inside the "queue" frame, which
      exists for filtering and paging. Without it the link would try to load the
      detail page INTO that frame, and the detail page has no "queue" frame, so
      the list would just empty itself. %>
  <%= link_to queue_row_path(registration_request),
        data: {
          turbo_frame: "_top",
          keyboard_nav_target: "item",
          claim_url: registration_request_claim_path(registration_request),
          claimed_by_me: registration_request.claimed_by == current_moderator
        },
        class: "block min-w-0 flex-1 py-3 pl-2 pr-4",
        id: dom_id(registration_request, :link) do %>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-medium">@<%= highlight_keywords(registration_request.username) %></span>
      <%= status_badge(registration_request) %>
      <% unless registration_request.confirmed? %>
        <span class="rounded-full bg-stone-100 dark:bg-stone-800 px-2 py-0.5 text-xs text-stone-600 dark:text-stone-300 ring-1 ring-stone-300 dark:ring-stone-700">Email not confirmed</span>
      <% end %>

      <% if registration_request.claimed? %>
        <span class="rounded-full bg-indigo-100 dark:bg-indigo-900 px-2 py-0.5 text-xs text-indigo-900 dark:text-indigo-200">
          <%= registration_request.claimed_by == current_moderator ? "Yours" : "#{registration_request.claimed_by&.name} is on it" %>
        </span>
      <% end %>

      <span class="ml-auto text-xs text-stone-500 dark:text-stone-400">
        <%= relative_time(registration_request.signed_up_at) %>
      </span>
    </div>

    <p class="mt-1 line-clamp-2 text-sm text-stone-600 dark:text-stone-300">
      <%= registration_request.invite_request.present? ?
            highlight_keywords(registration_request.invite_request) :
            tag.em("No reason given", class: "text-stone-500 dark:text-stone-400") %>
    </p>

    <% if registration_request.flags.any? %>
      <div class="mt-2 flex flex-wrap gap-1">
        <% registration_request.flags.sort_by { -it.severity_before_type_cast }.each do |flag| %>
          <span class="rounded px-1.5 py-0.5 text-xs <%= severity_style(flag.severity) %>"><%= flag.label %></span>
        <% end %>
      </div>
    <% end %>

    <% if registration_request.notes_count.positive? %>
      <p class="mt-1 text-xs text-stone-500 dark:text-stone-400"><%= pluralize(registration_request.notes_count, "note") %></p>
    <% end %>
  <% end %>
</li>
