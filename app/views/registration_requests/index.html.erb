<% content_for :page_title, "Queue" %>

<%# Live queue: sync inserts, claims and decisions all reach every open queue. %>
<%= turbo_stream_from current_instance, :registration_requests %>

<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Registration requests</h1>
    <p class="mt-1 text-sm text-stone-600 dark:text-stone-300">
      <%= current_instance.domain %> ·
      <%= @counts[:pending] %> pending,
      <%= @counts[:unclaimed] %> unclaimed,
      <%= @counts[:mine] %> yours
      <% if @counts[:unconfirmed].positive? %>
        · <%= link_to "#{@counts[:unconfirmed]} waiting for email confirmation",
                root_path(email: "unconfirmed"), class: "underline hover:text-stone-900 dark:hover:text-stone-100" %>
      <% end %>
    </p>
  </div>
  <div class="flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400">
    <p>Last synced <%= current_instance.last_synced_at ? relative_time(current_instance.last_synced_at) : "never" %></p>
    <%= button_to "Sync now", sync_path, class: button_classes(:outline, "px-2 py-1 whitespace-nowrap text-stone-700 dark:text-stone-300") %>
  </div>
</div>

<% if current_instance.last_sync_error.present? %>
  <div class="mb-4 rounded border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950 px-4 py-3 text-sm text-amber-900 dark:text-amber-200">
    <strong>Sync problem:</strong> <%= current_instance.last_sync_error %>
  </div>
<% end %>

<%= render "filters", query: @query %>

<%# bulk-select sits OUTSIDE the frame so it outlives filtering and paging, and
    so its dialog does too: a run keeps going while the rows it acts on vanish
    from the list underneath it. %>
<div data-controller="bulk-select"
     data-action="turbo:frame-load->bulk-select#reset turbo:morph@document->bulk-select#restore">
<%# A frame, not a stream: filtering and paging are THIS viewer's navigation.
    turbo_action advance keeps the URL shareable and the back button working. %>
<%= turbo_frame_tag "queue", data: { turbo_action: "advance" } do %>
  <% if @registration_requests.any? %>
    <%= render "bulk_toolbar" if @registration_requests.any?(&:pending?) %>
    <ul data-controller="keyboard-nav"
        class="divide-y divide-stone-200 dark:divide-stone-800 rounded-lg [&>li:first-child]:rounded-t-lg [&>li:last-child]:rounded-b-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900">
      <%= render partial: "registration_request", collection: @registration_requests %>
    </ul>

    <%= render "shared/pagination", pagination: @pagination, noun: "request",
          path: ->(page) { queue_page_path(page) } %>
  <% elsif @query.unfiltered? %>
    <div class="rounded-lg border border-dashed border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-6 py-12 text-center">
      <p class="text-3xl" aria-hidden="true">🎉</p>
      <p class="mt-2 font-medium text-stone-700 dark:text-stone-300">The waterhole is quiet.</p>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">Every applicant has been seen to. The herd can graze in peace.</p>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-6 py-12 text-center">
      <p class="font-medium text-stone-700 dark:text-stone-300">Nothing here.</p>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">No requests match these filters.</p>
    </div>
  <% end %>
<% end %>
<%= render "bulk_dialog" %>
</div>

<%= keyboard_shortcuts_link %>
