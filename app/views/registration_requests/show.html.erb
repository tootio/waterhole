<% content_for :title, "@#{@registration_request.username} — Waterhole" %>

<%# Per-request stream: notes append, and claim/decision changes refresh. %>
<%= turbo_stream_from @registration_request %>

<div class="mb-4">
  <%= link_to "← Back to queue", root_path, class: "text-sm text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100" %>
</div>

<div class="mb-4 flex flex-wrap items-center gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">@<%= @registration_request.username %></h1>
  <%= status_badge(@registration_request) %>
  <% if @registration_request.display_name.present? %>
    <span class="text-stone-500 dark:text-stone-400"><%= @registration_request.display_name %></span>
  <% end %>
</div>

<%= render "claim_banner", registration_request: @registration_request %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <section class="rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5">
      <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">Why they want to join</h2>
      <% if @registration_request.invite_request.present? %>
        <div data-controller="expandable" data-expandable-collapsed-height-value="240">
          <div data-expandable-target="content" class="overflow-hidden whitespace-pre-wrap text-lg leading-relaxed"><%= @registration_request.invite_request %></div>
          <button type="button" data-expandable-target="toggle" data-action="expandable#toggle"
                  class="mt-2 hidden text-sm text-stone-500 dark:text-stone-400 underline">Show more</button>
        </div>
        <p class="mt-3 text-xs text-stone-500 dark:text-stone-400"><%= pluralize(@registration_request.invite_request_words, "word") %></p>
      <% else %>
        <p class="text-stone-500 dark:text-stone-400 italic">They gave no reason.</p>
      <% end %>
    </section>

    <%= render "decision_panel", registration_request: @registration_request %>

    <section class="rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5">
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">
        Moderator notes (<span id="notes_count"><%= @registration_request.notes_count %></span>)
      </h2>

      <div id="notes" class="space-y-4">
        <%= render partial: "notes/note", collection: @notes, as: :note %>
      </div>

      <%= render "notes/form", registration_request: @registration_request, note: @note, parent: nil %>
    </section>
  </div>

  <aside class="space-y-6">
    <%= render "flags", registration_request: @registration_request %>
    <%= render "identity", registration_request: @registration_request %>

    <section class="rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5">
      <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">Purge from this Waterhole</h2>
      <p class="text-sm text-stone-600 dark:text-stone-300">
        Deletes this request here with everything about it: the applicant's data,
        the notes, flags and decision. Decided requests are purged automatically
        <%= pluralize(Waterhole::Deployment.retention.in_days.to_i, "day") %> after the decision. Nothing
        changes in Mastodon, and the request is not imported again.
      </p>
      <%= button_to "Purge this request", registration_request_purge_path(@registration_request),
            form: { data: { turbo_confirm: "Purge @#{@registration_request.username} and everything about it from this Waterhole, notes included? This cannot be undone." } },
            class: "mt-3 rounded border border-red-300 dark:border-red-800 bg-white dark:bg-stone-800 px-3 py-1.5 text-sm text-red-800 dark:text-red-300 hover:bg-red-50 dark:hover:bg-red-950" %>
    </section>
  </aside>
</div>
