<% content_for :title, "@#{@registration_request.username} — Waterhole" %>

<%# Per-request stream: notes append, and claim/decision changes refresh. %>
<%= turbo_stream_from @registration_request %>

<div class="mb-4">
  <%= link_to "← Back to queue", root_path, class: "text-sm text-stone-500 hover:text-stone-900" %>
</div>

<div class="mb-4 flex flex-wrap items-center gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">@<%= @registration_request.username %></h1>
  <%= status_badge(@registration_request) %>
  <% if @registration_request.display_name.present? %>
    <span class="text-stone-500"><%= @registration_request.display_name %></span>
  <% end %>
</div>

<%= render "claim_banner", registration_request: @registration_request %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <%# The reason for joining is what moderators actually read, so it leads at
        a readable size rather than being squeezed into a metadata table. %>
    <section class="rounded-lg border border-stone-200 bg-white p-5">
      <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">Why they want to join</h2>
      <% if @registration_request.invite_request.present? %>
        <div data-controller="expandable" data-expandable-collapsed-height-value="240">
          <%# Kept on one line: whitespace-pre-wrap would otherwise render the
              template's own indentation as part of the applicant's text. %>
          <div data-expandable-target="content" class="overflow-hidden whitespace-pre-wrap text-lg leading-relaxed"><%= @registration_request.invite_request %></div>
          <button type="button" data-expandable-target="toggle" data-action="expandable#toggle"
                  class="mt-2 hidden text-sm text-stone-500 underline">Show more</button>
        </div>
        <p class="mt-3 text-xs text-stone-400"><%= pluralize(@registration_request.invite_request_words, "word") %></p>
      <% else %>
        <p class="text-stone-400 italic">They gave no reason.</p>
      <% end %>
    </section>

    <%= render "decision_panel", registration_request: @registration_request %>

    <section class="rounded-lg border border-stone-200 bg-white p-5">
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-stone-500">
        Moderator notes (<span id="notes_count"><%= @registration_request.notes_count %></span>)
      </h2>

      <div id="notes" class="space-y-4">
        <%= render partial: "notes/note", collection: @notes, as: :note %>
      </div>

      <%= render "notes/form", registration_request: @registration_request, note: @note, parent: nil %>
    </section>
  </div>

  <aside class="space-y-6">
    <%= render "flags", registration_request: @registration_request %>
    <%= render "identity", registration_request: @registration_request %>
  </aside>
</div>
