<% content_for :title, "Not authorised — Waterhole" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-semibold tracking-tight">Can't sign in from <%= @domain %></h1>
  <p class="mt-2 text-stone-700 dark:text-stone-300"><%= @admission.message %></p>

  <% if @admission.policy_refusal? %>
    <%# Nothing the instance admin can do about this one; it is the operator's
        decision, so don't send them off to edit DNS for no reason. %>
    <div class="mt-6 rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5 text-sm text-stone-600 dark:text-stone-300">
      This is a decision by whoever runs this Waterhole, not something your
      instance can change. Get in touch with them if you think it's a mistake.
    </div>
  <% else %>
    <%= render "verifications/instructions", domain: @domain, signals: @signals, admission: @admission %>
  <% end %>

  <p class="mt-6">
    <%= link_to "← Try a different instance", new_session_path, class: "text-sm text-stone-500 dark:text-stone-400 underline" %>
  </p>
</div>
