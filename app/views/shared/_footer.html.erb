<footer class="mt-auto border-t border-stone-200 bg-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-6 text-sm text-stone-500">
    <span class="font-medium text-stone-700">Waterhole</span>
    <span class="text-stone-400"><%= Waterhole::Deployment.host %></span>

    <nav class="flex flex-wrap gap-x-4 gap-y-1">
      <%= link_to "Terms", terms_path, class: "hover:text-stone-900 hover:underline" %>
      <%= link_to "Privacy", privacy_path, class: "hover:text-stone-900 hover:underline" %>
      <%= link_to "Imprint", imprint_path, class: "hover:text-stone-900 hover:underline" %>
      <%= link_to "Authorise an instance", verification_path, class: "hover:text-stone-900 hover:underline" %>
      <%= link_to "Source code", Waterhole::Deployment.source_url, rel: "noopener", class: "hover:text-stone-900 hover:underline" %>
    </nav>

    <% unless LegalDocuments.published? %>
      <span class="rounded bg-red-50 px-2 py-0.5 text-xs text-red-800 sm:ml-auto">
        No legal documents published
      </span>
    <% end %>
  </div>
</footer>
