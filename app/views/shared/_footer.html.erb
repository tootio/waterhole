<footer class="mt-auto border-t border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-6 text-sm text-stone-500 dark:text-stone-400">
    <span class="font-medium text-stone-700 dark:text-stone-300">Waterhole <%= Waterhole::Deployment.version %></span>

    <nav class="flex flex-wrap gap-x-4 gap-y-1">
      <%= link_to "About", verification_path, class: "hover:text-stone-900 dark:hover:text-stone-100 hover:underline" %>
      <%= link_to "Terms", terms_path, class: "hover:text-stone-900 dark:hover:text-stone-100 hover:underline" %>
      <%= link_to "Privacy", privacy_path, class: "hover:text-stone-900 dark:hover:text-stone-100 hover:underline" %>
      <%= link_to "Imprint", imprint_path, class: "hover:text-stone-900 dark:hover:text-stone-100 hover:underline" %>
      <%= link_to "Source code", Waterhole::Deployment.source_url, rel: "noopener", class: "hover:text-stone-900 dark:hover:text-stone-100 hover:underline" %>
    </nav>

    <% unless LegalDocuments.published? %>
      <span class="rounded bg-red-50 dark:bg-red-950 px-2 py-0.5 text-xs text-red-800 dark:text-red-300 sm:ml-auto">
        No legal documents published
      </span>
    <% end %>
  </div>
</footer>
