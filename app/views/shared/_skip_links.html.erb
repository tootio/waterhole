<%# Hidden just above the screen, so the top stays 0 and only the focused
    position allows for the status bar. %>
<% skip_link_classes = "fixed left-[max(0.5rem,env(safe-area-inset-left))] top-0 z-50 block -translate-y-full focus:translate-y-[calc(0.5rem+env(safe-area-inset-top))] #{button_classes(:solid, "px-4 py-2")}" %>
<a href="#main-content"
   data-controller="skip-link" data-action="skip-link#skip"
   class="<%= skip_link_classes %>">
  Skip to main content
</a>
<% if signed_in? && current_moderator.consent_current? %>
  <a href="#main-navigation"
     data-controller="skip-link" data-action="skip-link#skip"
     class="<%= skip_link_classes %>">
    Skip to main navigation
  </a>
<% end %>
