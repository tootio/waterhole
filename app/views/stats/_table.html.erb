<%# The chart's numbers as a table: for screen readers, for anyone without
    JavaScript, and for the exact count the bars only suggest. %>
<details class="mt-4 text-sm">
  <summary class="cursor-pointer text-stone-600 dark:text-stone-300">Show as table</summary>
  <p class="mt-2 text-xs text-stone-500 dark:text-stone-400">
    <%= series.hourly? ? "Hours" : "Days (UTC)" %> without signups are left out.
  </p>
  <div class="mt-2 max-h-96 overflow-auto rounded border border-stone-200 dark:border-stone-800">
    <table class="w-full text-sm tabular-nums">
      <thead class="sticky top-0 bg-stone-50 dark:bg-stone-800 text-left text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">
        <tr>
          <th class="px-3 py-2 font-medium"><%= series.hourly? ? "Hour" : "Day" %></th>
          <% columns.each_value do |label| %><th class="px-3 py-2 text-right font-medium"><%= label %></th><% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-200 dark:divide-stone-800">
        <% series.buckets.each_with_index.reverse_each do |bucket, i| %>
          <% next if series.values["signups"][i].zero? %>
          <tr>
            <td class="whitespace-nowrap px-3 py-1.5"><%= stats_bucket_label(series, bucket) %></td>
            <% columns.each_key do |counter| %><td class="px-3 py-1.5 text-right"><%= series.values[counter][i] %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</details>
