<%# One control, but the same shape as the queue's filters: submits itself on
    change, into the frame, so the URL stays shareable. %>
<%= form_with url: sync_runs_path, method: :get, data: {
      turbo_frame: "sync_runs", controller: "auto-submit"
    }, class: "mb-4 flex flex-wrap items-end gap-3 rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-3" do |f| %>

  <div>
    <%= f.label :status, "Status", class: "block text-xs font-medium text-stone-600 dark:text-stone-300" %>
    <%= f.select :status,
          options_for_select([ %w[All all], %w[Succeeded succeeded], %w[Failed failed], %w[Running running] ], status),
          {}, data: { action: "change->auto-submit#submit" },
          class: "mt-1 rounded border border-stone-300 dark:border-stone-700 px-2 py-1.5 text-sm" %>
  </div>

  <noscript><%= f.submit "Filter", class: "rounded bg-stone-900 dark:bg-stone-100 px-3 py-1.5 text-sm text-white dark:text-stone-900" %></noscript>
<% end %>
