<% content_for :page_title, "Sync history" %>
<h1 class="mb-4 text-2xl font-semibold tracking-tight">Sync history</h1>

<%= render "filters", status: @status %>

<%# A frame, like the queue: filtering and paging are this viewer's navigation,
    and turbo_action advance keeps the URL shareable and the back button honest. %>
<%= turbo_frame_tag "sync_runs", data: { turbo_action: "advance" } do %>
  <% if @sync_runs.any? %>
    <div class="overflow-x-auto rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 dark:bg-stone-800 text-left text-xs uppercase tracking-wide text-stone-500 dark:text-stone-400">
          <tr>
            <th class="px-4 py-2 font-medium">Started</th>
            <th class="px-4 py-2 font-medium">Status</th>
            <th class="px-4 py-2 font-medium">Pages</th>
            <th class="px-4 py-2 font-medium">Seen</th>
            <th class="px-4 py-2 font-medium">New</th>
            <th class="px-4 py-2 font-medium">Resolved elsewhere</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-200 dark:divide-stone-800">
          <% @sync_runs.each do |run| %>
            <tr class="<%= "bg-red-50 dark:bg-red-950" if run.failed? %>">
              <td class="px-4 py-2"><%= local_time(run.started_at, format: :short) %></td>
              <td class="px-4 py-2"><%= run.status %></td>
              <td class="px-4 py-2"><%= run.pages_fetched %></td>
              <td class="px-4 py-2"><%= run.records_seen %></td>
              <td class="px-4 py-2"><%= run.records_created %></td>
              <td class="px-4 py-2"><%= run.records_resolved %></td>
            </tr>
            <% if run.error_message.present? %>
              <tr class="bg-red-50 dark:bg-red-950"><td colspan="6" class="px-4 pb-2 text-xs text-red-900 dark:text-red-200"><%= run.error_message %></td></tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination", pagination: @pagination, noun: "run",
          path: ->(page) { sync_runs_page_path(page) } %>
  <% else %>
    <p class="rounded-lg border border-dashed border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-6 py-12 text-center text-stone-500 dark:text-stone-400">
      <%= @status.present? && @status != "all" ? "No #{@status} syncs." : "No syncs yet." %>
    </p>
  <% end %>
<% end %>
