<% content_for :page_title, "About" %>
<% content_for :description, "How #{Waterhole::Deployment.host} moderates Mastodon registrations with Waterhole, and how to bring your own instance's herd." %>

<div class="mx-auto max-w-2xl">
  <div class="mb-8 text-center">
    <%= image_tag "/mammoth-3d.webp", alt: "", class: "mx-auto size-24" %>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">About <%= Waterhole::Deployment.host %></h1>
    <p class="mt-2 text-sm text-stone-600 dark:text-stone-300">
      <%= ApplicationHelper::TAGLINE %>
    </p>
  </div>

  <%= render "shared/about", class: "mt-3 text-stone-700 dark:text-stone-300 text-xl [&>p]:my-2" %>

  <h2 class="mt-8 text-lg font-semibold tracking-tight">Bring your herd</h2>
  <p class="mt-2 text-stone-700 dark:text-stone-300">
    Before your moderators can sign in, someone who controls your instance's DNS
    has to say they want this Waterhole.
  </p>

  <%= form_with url: verification_path, method: :post, class: "mt-6 flex gap-2" do |f| %>
    <%= f.text_field :instance_domain, value: @domain, placeholder: "mastodon.example", required: true,
          class: "flex-1 rounded border border-stone-300 dark:border-stone-700 px-3 py-2" %>
    <%= f.submit "Check", class: "rounded bg-stone-900 dark:bg-stone-100 px-4 py-2 text-white dark:text-stone-900" %>
  <% end %>

  <% if @domain.present? %>
    <%= render "verifications/instructions", domain: @domain, signals: @signals, admission: @admission %>
  <% else %>
    <%= turbo_frame_tag "verification_result", target: "_top" do %>
      <div class="mt-8">
        <h2 class="text-lg font-semibold tracking-tight">This Waterhole</h2>

        <dl class="mt-3 rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 divide-y divide-stone-200 dark:divide-stone-800">
          <div class="flex justify-between gap-4 px-4 py-3">
            <dt class="text-stone-500 dark:text-stone-400">Version</dt>
            <dd class="font-medium"><%= Waterhole::Deployment.version %></dd>
          </div>
          <div class="flex justify-between gap-4 px-4 py-3">
            <dt class="text-stone-500 dark:text-stone-400">Admission policy</dt>
            <dd class="font-medium"><%= Waterhole::Deployment.policy_mode.humanize %></dd>
          </div>
          <div class="flex justify-between gap-4 px-4 py-3">
            <dt class="text-stone-500 dark:text-stone-400">IFTAS DNI sync</dt>
            <dd class="font-medium"><%= Waterhole::Deployment.iftas_dni_sync_enabled? ? "Enabled (weekly)" : "Disabled" %></dd>
          </div>
        </dl>

        <p class="mt-3 text-xs text-stone-500 dark:text-stone-400">
          <% if Waterhole::Deployment.allowlist_only? %>
            Allowlist only: an instance may bring its herd here only once its domain has been added with
            <code>bin/rails waterhole:herd:allow</code>.
          <% else %>
            Allow all: any instance publishing the DNS record may bring its herd here, except domains on
            the blocklist below.
          <% end %>
        </p>

        <h3 class="mt-6 text-sm font-semibold">Domain blocklist</h3>
        <p class="mt-2 text-sm text-stone-700 dark:text-stone-300">
          Domains refused a herd here, whether blocked by the operator directly or synced from a shared
          list such as IFTAS's DNI.
        </p>

        <%= render "shared/domain_blocklist", domain_policies: @domain_policies %>
      </div>
    <% end %>
  <% end %>
</div>
