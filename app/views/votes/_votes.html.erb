<% mine = votes.find { it.moderator_id == current_moderator&.id } %>
<div id="votes" class="mb-5 border-b border-stone-200 dark:border-stone-800 pb-4">
  <dl class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
    <% { "approve" => "text-emerald-700 dark:text-emerald-400", "reject" => "text-red-700 dark:text-red-400" }.each do |vote, color| %>
      <% voters = votes.select { it.vote == vote } %>
      <div class="flex flex-wrap items-baseline gap-x-1.5">
        <dt class="font-semibold <%= color %>"><%= voters.size %> <%= vote %></dt>
        <% if voters.any? %>
          <dd class="text-xs text-stone-500 dark:text-stone-400"><%= voters.map { it.moderator.name }.to_sentence %></dd>
        <% end %>
      </div>
    <% end %>
  </dl>

  <% unless registration_request.resolved? %>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
      <span class="text-stone-500 dark:text-stone-400">Your vote:</span>
      <% vote_buttons = {
           "approve" => { mark: "✔︎",
             pressed: "border-emerald-600 bg-emerald-600 text-white hover:bg-emerald-700",
             open: "border-emerald-600 text-emerald-700 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950" },
           "reject" => { mark: "✘",
             pressed: "border-red-600 bg-red-600 text-white hover:bg-red-700",
             open: "border-red-600 text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950" }
         } %>
      <% vote_buttons.each do |vote, style| %>
        <% pressed = mine&.vote == vote %>
        <%# Pressing your current vote again withdraws it. %>
        <%= button_to (pressed ? registration_request_vote_path(registration_request) : registration_request_vote_path(registration_request, vote:)),
              method: (pressed ? :delete : :patch),
              title: (pressed ? "Withdraw your vote" : "Vote to #{vote}"),
              "aria-pressed": pressed.to_s,
              class: "rounded border px-3 py-1 font-medium #{pressed ? style[:pressed] : style[:open]} #{focus_ring_classes}" do %>
          <span aria-hidden="true"><%= style[:mark] %> </span><%= vote.capitalize %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
